# =====================================================================
# SKY AI - Configuration File
# =====================================================================

# [REQUIRED] Primary Groq API Key - Get yours from https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# [OPTIONAL] Backup Groq API Key (Auto-fallback when primary hits quota or rate limits)
GROQ_API_KEY1=your_backup_groq_api_key_here

# Groq Model for Executor and Toolbuilder Agents
# Options: llama-3.3-70b-versatile, llama-3.1-70b-versatile, llama3-70b-8192, mixtral-8x7b-32768
GROQ_MODEL=llama-3.3-70b-versatile

# Whisper Model (used via Groq API for lightning-fast voice transcription)
WHISPER_MODEL=whisper-large-v3

# [OPTIONAL] Picovoice Porcupine AccessKey - Get free key from https://console.picovoice.ai/
# If provided, hardware-accelerated wake-word detection is used.
# If omitted or empty, Sky uses continuous audio keyword detection automatically!
PICOVOICE_ACCESS_KEY=

# Wake words/phrases that trigger Sky (comma-separated, case-insensitive)
# Any sentence containing these words will trigger Sky.
WAKE_WORDS=hey sky,wake up sky,sky

# Text-to-Speech (TTS) enabled
ENABLE_TTS=true

# Dynamic Tools Directory Path (default: ./sky/tools/dynamic)
DYNAMIC_TOOLS_DIR=sky/tools/dynamic
